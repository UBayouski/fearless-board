{
  "hosting": {
    "public": "packages/app/dist-site",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      { "source": "/data/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ]
  }
}
