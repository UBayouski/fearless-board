{
  "name": "fearless-board",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Series-long League of Legends draft planner for Fearless Draft.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @fearless-board/app dev",
    "build": "pnpm --filter @fearless-board/app build",
    "build:demo": "pnpm --filter @fearless-board/app exec vite build --mode demo && node scripts/clean-demo.mjs && node scripts/check-demo.mjs",
    "data": "pnpm --filter @fearless-board/pipeline start",
    "data:notes": "node packages/pipeline/src/notes.ts",
    "data:demo": "node packages/pipeline/src/demo.ts",
    "test": "node --test \"packages/*/src/**/*.test.ts\" && pnpm --filter @fearless-board/app exec vitest run",
    "typecheck": "tsc -p packages/shared && tsc -p packages/pipeline && pnpm --filter @fearless-board/app exec tsc -b",
    "lint": "pnpm --filter @fearless-board/app lint",
    "check:data": "node scripts/check-no-data.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0"
  }
}
