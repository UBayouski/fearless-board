# Copy to .env and fill in. .env is ignored by git; never commit a real key.

# Gemini API key, used only by the pipeline to write the between-games briefs.
# The key must belong to a project with billing enabled: on the free tier Google
# may use prompts to improve its products, which the hackathon data licence does not allow.
GEMINI_API_KEY=

# Model for the briefs.
GEMINI_MODEL=gemini-3.8-flash
